// William Gannon// <wgannnon@mindspring.com>// **************************Programming Projects 6.30***********************class Bank {	private Account[] active_accounts;	private int accounts_held = 0;	public Bank(){		accounts_held = 30;		active_accounts = new Account[accounts_held];		active_accounts[0] = 			new Account("William Gannon\t", "#00001", 00.99);		active_accounts[1] = 			new Account("Richard Draper\t", "#00002", 100000.01);		active_accounts[2] = 			new Account("William Voght\t", "#00003", 211918.17);		active_accounts[3] = 			new Account("Shirley Johnson", "#00004", 300100.92);		active_accounts[4] = 			new Account("Richard Draper\t", "#00005", 60.02);		active_accounts[5] = 			new Account("Dudley Dorite\t", "#00006", 1000.02);		active_accounts[6] = 			new Account("Phil Houser\t", "#00007", 6.08);		active_accounts[7] = 			new Account("Jason Rabbits\t", "#00008", 2.04);		active_accounts[8] = 			new Account("Phil Grammer\t", "#00009", 4.02);		active_accounts[9] = 			new Account("Douglas McDonnell", "#00010", 474.95);		active_accounts[10] = 			new Account("Wink Martindale", "#00011", 500.05);		active_accounts[11] = 			new Account("Fred Esprez\t", "#00012", .01);		active_accounts[12] = 			new Account("Ronald McDonald", "#00013", 1.99);		active_accounts[13] = 			new Account("Robert Marley\t", "#00014", 420.01);		active_accounts[14] = 			new Account("Jerome Garcia\t", "#00015", 1995.65);		active_accounts[15] = 			new Account("Dylan Bobbie\t", "#00016", .44);		active_accounts[16] = 			new Account("James Hendrickson", "#00017", 69.99);		active_accounts[17] = 			new Account("John Winston\t", "#00018", 9.09);		active_accounts[18] = 			new Account("Ono Lennon\t", "#00019", 9.09);		active_accounts[19] = 			new Account("Jill Peters\t", "#00020", 00.55);		active_accounts[20] = 			new Account("Kim Gilder\t", "#00021", 77.69);		active_accounts[21] = 			new Account("Archibald Barasol", "#00022", 63.89);		active_accounts[22] = new Account();		active_accounts[23] = new Account();		active_accounts[24] = new Account();		active_accounts[25] = new Account();		active_accounts[26] = new Account();		active_accounts[27] = new Account();		active_accounts[28] = new Account();		active_accounts[29] = new Account();		} // Constructor Bank	public Account getAccountInfo(String target_account){		int index = 0;			while (index < accounts_held){			if (active_accounts[index].getAccountNumber() == target_account)				return active_accounts[index];				index++;		}		return null;	} // method getAccountInfo			public void interest(){				System.out.println("--Daily Interest--");		for(int index = 0; index < accounts_held; index++){			active_accounts[index].interest();		}	} // method interest	public void print(){		System.out.println("Name:\tAccount Number:\tBalance:");		for			(int account_holder=0; account_holder < accounts_held;				 account_holder++){					active_accounts[account_holder].print();			}	}//method print} // class Bank